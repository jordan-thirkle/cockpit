# Dependencies
node_modules/

# Build output (regenerate with `npm run build`)
dist/

# Logs
npm-debug.log*
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local env / secrets
.env
.env.local
*.local

# TypeScript incremental build cache (regenerated by tsc -b)
tsconfig.tsbuildinfo
*.tsbuildinfo

# Cockpit runtime metadata is stored server-side in HERMES_HOME/data/cockpit,
# never committed.

# Local audit/diagnostic tooling (Playwright probes, screenshots) — dev-only,
# must NOT be swept into feature/fix commits.
audit-panels.mjs
diag.mjs
diag2.mjs
audit-shots/
screenshots/
