# Dependencies
node_modules/

# Build output (regenerate with `npm run build`)
dist/

# Logs
npm-debug.log*
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local env / secrets
.env
.env.local
*.local

# TypeScript incremental build cache (regenerated by tsc -b)
tsconfig.tsbuildinfo
*.tsbuildinfo

# Cockpit runtime metadata is stored server-side in HERMES_HOME/data/cockpit,
# never committed.

# Local audit/debug/diagnostic tooling (screenshot probes, audit results) — dev-only.
*.png
cockpit_results/
cockpit_results_v*
cockpit_screenshots/
cockpit_screenshots_v*
audit-panels.mjs
diag.mjs
diag2.mjs

# Null device on Windows — not a real file, never committed.
nul
