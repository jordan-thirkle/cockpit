{
  "name": "cockpit",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Cockpit — a bespoke, open-source dashboard shell and chat organizer for Hermes Agent. Organize sessions into folders/workspaces and chat from a calm, byjtt-branded UI that rides the stock Hermes backend via HERMES_WEB_DIST, so `hermes update` never breaks your customizations.",
  "keywords": [
    "hermes-agent",
    "hermes",
    "ai-agent",
    "dashboard",
    "chat-organizer",
    "self-hosted",
    "llm",
    "agent-cockpit",
    "byjtt",
    "nous-research",
    "terminal-ui",
    "workspace"
  ],
  "homepage": "https://github.com/jordan-thirkle/cockpit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jordan-thirkle/cockpit.git"
  },
  "bugs": {
    "url": "https://github.com/jordan-thirkle/cockpit/issues"
  },
  "author": "By JTT",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@nous-research/ui": "^1.5.2",
    "@observablehq/plot": "^0.6.17",
    "@react-three/fiber": "^9.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "gsap": "^3.15.0",
    "leva": "^0.10.1",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
